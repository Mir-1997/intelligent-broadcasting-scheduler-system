# Copy to backend/.env and adjust. Every variable is optional.

# 'firestore' (default) or 'memory' (no database, state lost on restart)
STORAGE_BACKEND=firestore

# Firestore emulator (default). Leave empty to use a real Firebase project.
FIRESTORE_EMULATOR_HOST=localhost:8080
GCP_PROJECT_ID=demo-broadcast-scheduler
FIRESTORE_DATABASE=(default)
COLLECTION_PREFIX=

# Real project: path to a service-account JSON key. If unset, Application Default
# Credentials are used. Values in this file override variables exported by your shell.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Matching
MAX_MATCH_RADIUS_MILES=5

# Admin seed, used only when no admin document exists yet
ADMIN_NAME=Admin HQ
ADMIN_LAT=40.7580
ADMIN_LNG=-73.9855

# JSON list of allowed browser origins
CORS_ORIGINS=["*"]
WEBSOCKET_QUEUE_SIZE=1000
